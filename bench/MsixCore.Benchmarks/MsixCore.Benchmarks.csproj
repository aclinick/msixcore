<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- BenchmarkDotNet emits its own build artifacts; no XML docs needed for the harness. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- BenchmarkDotNet requires public benchmark types/methods and instance benchmark methods,
         which conflict with a handful of analyzer rules that are appropriate for library code
         but not for a benchmark host. Scope the suppressions to this project only. -->
    <NoWarn>$(NoWarn);CA1515;CA1822;CA5394</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MsixCore.Packaging\MsixCore.Packaging.csproj" />
    <ProjectReference Include="..\..\src\MsixCore.Deployment\MsixCore.Deployment.csproj" />
  </ItemGroup>

</Project>
