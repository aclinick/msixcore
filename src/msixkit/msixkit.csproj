<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MsixCore.PackageStore\MsixCore.PackageStore.csproj" />
    <ProjectReference Include="..\MsixCore.Packaging\MsixCore.Packaging.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MsixKit</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>msixkit</PackageId>
    <Description>Cross-platform dotnet tool for inspecting, validating, unpacking, and authoring MSIX/APPX packages.</Description>
    <PackageTags>msix;appx;dotnet-tool;validation;unpack;pack;authoring;cross-platform</PackageTags>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>msixkit</ToolCommandName>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="msixkit.Tests" />
  </ItemGroup>

</Project>
