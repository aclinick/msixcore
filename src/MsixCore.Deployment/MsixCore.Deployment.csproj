<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MsixCore.Packaging\MsixCore.Packaging.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>MsixCore.Deployment</PackageId>
    <Description>Cross-platform .NET APIs for extracting, installing, removing, and querying MSIX/APPX packages.</Description>
    <PackageTags>msix;appx;deployment;installation;extraction;cross-platform</PackageTags>
    <EnablePackageValidation>true</EnablePackageValidation>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MsixCore.Deployment.Tests" />
  </ItemGroup>

</Project>
