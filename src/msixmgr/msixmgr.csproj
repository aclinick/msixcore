<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MsixCore.Deployment\MsixCore.Deployment.csproj" />
    <ProjectReference Include="..\MsixCore.Packaging\MsixCore.Packaging.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>msixmgr</PackageId>
    <Description>Cross-platform dotnet tool for inspecting, validating, unpacking, and authoring MSIX/APPX packages.</Description>
    <PackageTags>msix;appx;dotnet-tool;validation;unpack;pack;authoring;cross-platform</PackageTags>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>msixmgr</ToolCommandName>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="msixmgr.Tests" />
  </ItemGroup>

</Project>
