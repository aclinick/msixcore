<Window
    x:Class="MsixCore.Studio.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="MSIX Core Studio"
    Width="1100"
    Height="760"
    MinWidth="760"
    MinHeight="520">
  <Grid RowDefinitions="Auto,Auto,*">
    <Border Padding="20,16" Background="{DynamicResource SystemAccentColor}">
      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Spacing="2">
          <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="White" Text="MSIX Core Studio" />
          <TextBlock Foreground="White" Opacity="0.85" Text="Cross-platform package inspection" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Command="{Binding OpenPackageCommand}" Content="Open package…" />
          <Button Command="{Binding OpenFolderCommand}" Content="Open folder…" />
        </StackPanel>
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Margin="20,12" Spacing="6">
      <TextBlock FontWeight="SemiBold" Text="{Binding StatusMessage}" />
      <TextBlock FontSize="12" Text="{Binding SourcePath}" TextTrimming="CharacterEllipsis" />
      <ProgressBar Height="3" IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
      <Border Padding="10" Background="#22D13438" CornerRadius="4" IsVisible="{Binding HasError}">
        <TextBlock Foreground="{DynamicResource SystemErrorTextColor}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
      </Border>
    </StackPanel>

    <TabControl Grid.Row="2" Margin="20,0,20,20" IsEnabled="{Binding HasPackage}">
      <TabItem Header="Overview">
        <ScrollViewer>
          <StackPanel Margin="16" Spacing="18">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Package identity" />
            <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
              <TextBlock FontWeight="SemiBold" Text="Name" />
              <TextBlock Grid.Column="1" Text="{Binding IdentityName}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Publisher" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding Publisher}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Version" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Version}" />
              <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Architecture" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding Architecture}" />
              <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="Family name" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding PackageFamilyName}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="5" FontWeight="SemiBold" Text="Full name" />
              <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding PackageFullName}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="6" FontWeight="SemiBold" Text="Display name" />
              <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DisplayName}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="7" FontWeight="SemiBold" Text="Publisher display name" />
              <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding PublisherDisplayName}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="8" FontWeight="SemiBold" Text="Package type" />
              <TextBlock Grid.Row="8" Grid.Column="1" Text="{Binding FrameworkStatus}" />
            </Grid>

            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Capabilities" />
            <ItemsControl ItemsSource="{Binding Capabilities}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Margin="8,3" Text="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Applications">
        <ScrollViewer>
          <ItemsControl Margin="16" ItemsSource="{Binding Applications}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Margin="0,0,0,10" Padding="14" BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}" BorderThickness="1" CornerRadius="6">
                  <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="6">
                    <TextBlock FontWeight="SemiBold" Text="Application ID" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding Id}" />
                    <TextBlock Grid.Row="1" Text="Display name" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding DisplayName}" />
                    <TextBlock Grid.Row="2" Text="Executable" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding Executable}" />
                    <TextBlock Grid.Row="3" Text="Entry point" />
                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding EntryPoint}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>

      <TabItem Header="Files &amp; Block Map">
        <Grid Margin="16" RowDefinitions="Auto,*">
          <Border Padding="12" Background="{DynamicResource SystemControlBackgroundBaseLowBrush}" CornerRadius="6">
            <StackPanel>
              <TextBlock FontWeight="SemiBold" Text="Verification result" />
              <TextBlock Text="{Binding BlockMapStatus}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <ScrollViewer Grid.Row="1" Margin="0,12,0,0">
            <ItemsControl ItemsSource="{Binding BlockMapFiles}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="4" ColumnDefinitions="*,100,100,280">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding Size, StringFormat={}{0:N0} bytes}" />
                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" Text="{Binding BlockCount, StringFormat={}{0} blocks}" />
                    <TextBlock Grid.Column="3" Margin="18,0,0,0" Text="{Binding Verification}" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </Grid>
      </TabItem>

      <TabItem Header="Signature">
        <ScrollViewer>
          <StackPanel Margin="16" Spacing="16">
            <TextBlock FontSize="20" FontWeight="SemiBold" Text="{Binding SignatureStatus}" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="170,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8">
              <TextBlock FontWeight="SemiBold" Text="Signer subject" />
              <TextBlock Grid.Column="1" Text="{Binding SignatureSubject}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="1" FontWeight="SemiBold" Text="Issuer" />
              <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SignatureIssuer}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="2" FontWeight="SemiBold" Text="Thumbprint" />
              <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SignatureThumbprint}" TextWrapping="Wrap" />
              <TextBlock Grid.Row="3" FontWeight="SemiBold" Text="Certificate validity" />
              <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SignatureValidity}" />
              <TextBlock Grid.Row="4" FontWeight="SemiBold" Text="CMS integrity" />
              <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SignatureCmsIntegrity}" />
              <TextBlock Grid.Row="5" FontWeight="SemiBold" Text="Publisher match" />
              <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding SignaturePublisherMatch}" />
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </Grid>
</Window>
