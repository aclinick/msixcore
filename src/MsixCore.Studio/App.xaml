<Application
    x:Class="MsixCore.Studio.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
      </ResourceDictionary.MergedDictionaries>

      <Style x:Key="StudioPageTitleStyle" BasedOn="{StaticResource TitleTextBlockStyle}" TargetType="TextBlock" />

      <Style x:Key="StudioSectionTitleStyle" BasedOn="{StaticResource SubtitleTextBlockStyle}" TargetType="TextBlock" />

      <Style x:Key="StudioMetadataLabelStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock" />

      <Style x:Key="StudioPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="16" />
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
